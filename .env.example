# Salin file ini menjadi ".env" lalu isi nilainya

# Database lokal (SQLite) — tidak perlu diubah
DATABASE_URL="file:./dev.db"

# ---- IS3 Storage (S3-compatible) ----
# Endpoint API storage, contoh: https://s3.is3-provider.com
IS3_ENDPOINT_URL=
# Region sesuai panel penyedia, contoh: us-east-1 atau ap-southeast-1
IS3_REGION=
# Kredensial dari panel IS3
IS3_ACCESS_KEY_ID=
IS3_SECRET_ACCESS_KEY=
# Nama bucket untuk menyimpan video
IS3_BUCKET=
# Base URL publik bucket untuk playback, contoh: https://bucket-name.s3.is3-provider.com
IS3_PUBLIC_BASE_URL=

# Opsional: path FFmpeg custom (kosongkan untuk pakai bawaan sistem/ffmpeg-static)
FFMPEG_PATH=
